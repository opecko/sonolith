{
  "name": "ytdesk",
  "private": true,
  "version": "2.2.0",
  "description": "Lightweight YouTube Music desktop client",
  "license": "MIT",
  "repository": "github:opecko/ytdesk",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "dbg": "tsx scripts/dbg.ts",
    "tauri": "tauri",
    "build:deb": "tauri build --bundles deb",
    "build:win": "PATH=/usr/lib/llvm-18/bin:$PATH tauri build --runner cargo-xwin --target x86_64-pc-windows-msvc --bundles nsis",
    "release": "bash scripts/release.sh"
  },
  "dependencies": {
    "@material/material-color-utilities": "^0.4.0",
    "@tauri-apps/api": "^2.12.1",
    "@tauri-apps/plugin-global-shortcut": "^2.4.0",
    "@tauri-apps/plugin-http": "^2.8.0",
    "lucide-react": "^1.51.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "youtubei.js": "^18.1.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.12.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
